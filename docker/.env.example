# Copy to .env (cp .env.example .env) and edit. docker compose reads it
# automatically. Nothing here is required — defaults match dev mode.

# If set, /api/crack requires this exact X-API-Key. Leave blank to accept any
# non-empty key.
STEGAPP_API_KEY=

# stegseek release compiled from source in the build stage.
STEGSEEK_VERSION=0.6
